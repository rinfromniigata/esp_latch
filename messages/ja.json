				{
					"declarations": [
						"input count",
						"local countPlural = count: plural"
					],
					"selectors": [
						"countPlural"
					],
					"match": {
						"countPlural=other": "このデバイスのボリューム{count}個をすべて取り外します。マウント中のESPも取り外されます。"
					}
				}
			],
			"confirm": "取り出す"
		},
		"cancel": "キャンセル"
