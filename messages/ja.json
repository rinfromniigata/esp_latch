{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"app": {
		"name": "ESP Latch"
	},
	"toolbar": {
		"refresh": "更新",
		"settings": "設定",
		"log": "操作ログ"
	},
	"device_list": {
		"title": "ストレージ",
		"count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "{count}台"
				}
			}
		],
		"count_filtered": "{shown}台／全{total}台"
	},
	"filter": {
		"all": "全て",
		"physical": "物理",
		"esp": "ESPあり"
	},
	"device": {
		"kind": {
			"internal": "内蔵",
			"external": "外付け",
			"image": "ディスクイメージ"
		},
		"esp_count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "ESP {count}個"
				}
			}
		],
		"esp_none": "ESPなし",
		"mounted_count": [
			{
				"declarations": [
					"input count",
