		"privileged": "管理者権限で実行中"
	},
	"toast": {
		"mount_success": {
			"title": "マウントしました",
			"body": "{id} を {path} にマウントしました。"
		},
		"mount_failed": {
			"title": "マウントできませんでした"
		},
		"auth_cancelled": {
			"title": "認証がキャンセルされました",
			"body": "ESPのマウントには管理者の権限が必要です。"
		},
		"trash_emptied": {
			"title": "ゴミ箱を空にしました",
			"body": "{id} の空き容量が {size} 増えました。"
		},
		"retry": "再試行",
