		"section_title": "其他分区",
		"container_label": "APFS 容器",
		"toggle_container": "显示容器和宗卷",
		"volume_count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "{count} 个宗卷"
				}
			}
		]
	},
