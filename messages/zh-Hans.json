{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"app": {
		"name": "ESP Latch"
	},
	"toolbar": {
		"refresh": "刷新",
		"settings": "设置",
		"log": "操作日志"
	},
	"device_list": {
		"title": "存储设备",
		"count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "{count} 台"
				}
			}
		],
		"count_filtered": "{shown} 台 / 共 {total} 台"
	},
	"filter": {
		"all": "全部",
		"physical": "物理",
		"esp": "有 ESP"
	},
	"device": {
		"kind": {
			"internal": "内置",
			"external": "外置",
			"image": "磁盘映像"
		},
		"esp_count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "{count} 个 ESP"
				}
			}
		],
		"esp_none": "无 ESP",
		"more_labels": "另 {count} 个",
		"mounted_count": [
			{
				"declarations": [
					"input count",
					"local countPlural = count: plural"
				],
				"selectors": [
					"countPlural"
				],
				"match": {
					"countPlural=other": "{count} 个已挂载"
				}
			}
		],
		"on_store": "位于 {store}"
	},
	"detail": {
		"eject_device": "推出设备",
