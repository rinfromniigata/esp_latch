		},
		"no_esp": {
			"title": "此设备没有 ESP",
			"body": "未在 {device} 上找到 EFI 系统分区。"
		},
		"select": {
			"title": "请选择设备",
			"body": "从左侧列表中选择存储设备，即可操作其 ESP。"
		}
	},
	"status": {
		"loading": "正在读取设备…",
		"ready": "{count} 台设备，其中 {esp} 台有 ESP",
		"last_command": "上一条命令",
		"waiting_auth": "正在等待管理员认证…",
		"privileged": "正在以管理员权限运行"
	},
	"toast": {
		"mount_success": {
			"title": "已挂载",
			"body": "已将 {id} 挂载到 {path}。"
		},
		"mount_failed": {
			"title": "无法挂载"
		},
		"auth_cancelled": {
			"title": "认证已取消",
			"body": "挂载 ESP 需要管理员权限。"
		},
		"trash_emptied": {
			"title": "已清倒废纸篓",
			"body": "已在 {id} 上释放 {size}。"
		},
		"retry": "重试",
		"show_log": "查看日志",
		"close": "关闭"
	},
	"error": {
		"command_failed": {
			"title": "命令执行失败"
		},
		"not_esp": {
			"title": "不是 ESP",
			"body": "此分区不是 EFI 系统分区，无法操作。"
		},
		"invalid_target": {
			"title": "找不到目标",
			"body": "已连接的设备可能发生了变化。请刷新列表后重试。"
		},
		"busy": {
			"title": "正在执行操作",
			"body": "请等待该设备上的当前操作完成。"
		},
		"helper_unavailable": {
			"title": "无法启动管理员权限辅助进程",
			"body": "请重新启动应用后重试。"
		},
		"not_mounted": {
			"title": "未挂载",
			"body": "请刷新列表，确认 ESP 的状态。"
		},
		"io": {
			"title": "操作失败",
			"body": "读写文件时发生错误。请重试。"
		}
	},
	"modal": {
		"eject": {
			"label": "推出设备",
			"title": "要推出 {device} 吗？",
			"body": [
				{
					"declarations": [
						"input count",
						"local countPlural = count: plural"
					],
					"selectors": [
						"countPlural"
					],
					"match": {
						"countPlural=other": "将卸载此设备上的全部 {count} 个宗卷，包括已挂载的 ESP。"
					}
				}
			],
			"confirm": "推出"
		},
		"cancel": "取消"
	},
